{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "docex",
  "version": "0.2.0",
  "identifier": "de.tschieber.docex",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:5173",
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build"
  },
  "app": {
    "windows": [{ "label": "main", "title": "docex", "width": 1320, "height": 900, "minWidth": 800, "minHeight": 500 }],
    "security": { "csp": null }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/128x128@2x.png", "icons/icon.png", "icons/icon.icns", "icons/icon.ico"]
  }
}
